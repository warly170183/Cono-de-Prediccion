import fs from 'fs';
import os from 'os';
import path from 'path';
process.env.DATA_DIR = fs.mkdtempSync(path.join(os.tmpdir(), 'alerts-'));
const { collectAlertCandidates, dispatchCandidates, publicAlertSettings, saveAlertSettings } = await import('../server/alerts.ts');
let fail = 0;
const ok = (c: boolean, m: string) => { console.log((c ? 'OK    ' : 'FALLO ') + m); if (!c) fail++; };
const now = Date.now();
const opt: any = { id: 'a1', asset: 'btc', dir: 'long', strategyKey: 'trend_pullback', status: 'open', verdict: 'validada', createdTs: now - 3600_000, entryPrice: 100, stopLoss: 98, takeProfit1: 104, rr: 2 };
let c = collectAlertCandidates({ options: [opt, { ...opt, id: 'a2', verdict: 'dudosa' }, { ...opt, id: 'a3', status: 'tp_hit' }], now, proximityPct: 0.5 });
ok(c.length === 1 && c[0].key === 'setup:a1', 'solo setups validados y abiertos');
c = collectAlertCandidates({ options: [], now, gex: { spot: 100000, flip: 100300, callWall: 110000, putWall: 90000 }, proximityPct: 0.5 });
ok(c.length === 1 && c[0].event === 'gex', 'aviso por cercanía al gamma flip (0,3 %)');
c = collectAlertCandidates({ options: [], now, health: [{ id: 'cone_btc_24', module: 'Cono', level: 'bad', text: 'x' }, { id: 'sources', module: 'F', level: 'warn', text: 'y' }, { id: 'micro', module: 'M', level: 'bad', text: 'z' }], proximityPct: 0.5 });
ok(c.length === 2, 'cono descalibrado y fuentes degradadas (otros módulos no)');
// envío con fetch simulado
const calls: string[] = [];
let failNext = false;
(globalThis as any).fetch = async (url: string) => { calls.push(String(url)); return { ok: !failNext } as Response; };
saveAlertSettings({ enabled: true, telegramToken: 'SECRETO', telegramChatId: '1' });
ok(!JSON.stringify(publicAlertSettings()).includes('SECRETO') && publicAlertSettings().telegramConfigured, 'la interfaz nunca recibe el token');
const cand = [{ key: 'setup:a1', event: 'setup' as const, once: true, text: 't' }];
ok((await dispatchCandidates(cand, now)).length === 1 && calls.length === 1 && calls[0].includes('api.telegram.org'), 'envía por Telegram');
ok((await dispatchCandidates(cand, now + 86400_000)).length === 0, 'una sola vez por setup');
const rep = [{ key: 'gex:call wall', event: 'gex' as const, once: false, text: 'g' }];
await dispatchCandidates(rep, now);
ok((await dispatchCandidates(rep, now + 3600_000)).length === 0, 'enfriamiento de 6 h');
ok((await dispatchCandidates(rep, now + 7 * 3600_000)).length === 1, 'se repite pasado el enfriamiento');
failNext = true;
ok((await dispatchCandidates([{ key: 'k2', event: 'setup', once: true, text: 'q' }], now)).length === 0, 'si falla el envío no se marca como enviado');
failNext = false;
ok((await dispatchCandidates([{ key: 'k2', event: 'setup', once: true, text: 'q' }], now)).length === 1, '…y se reintenta después');
saveAlertSettings({ events: { setup: false, gex: true, cono: true, fuentes: true } });
ok((await dispatchCandidates([{ key: 'k3', event: 'setup', once: true, text: 'q' }], now)).length === 0, 'evento desactivado no envía');
saveAlertSettings({ telegramToken: '' });
ok(!publicAlertSettings().telegramConfigured, 'vaciar el campo borra el token');
saveAlertSettings({ enabled: undefined, telegramChatId: '9' } as never);
ok(publicAlertSettings().enabled === true, 'campos undefined no pisan los ajustes');
if (fail) process.exit(1);
